# ── Server sirlari (hech qachon brauzerga chiqmaydi) ────────────────────────
# OpenAI: ovozli yordamchi (STT + chat + TTS)
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_STT_MODEL=whisper-1
OPENAI_TTS_MODEL=gpt-4o-mini-tts

# Birinchi ishga tushishda yaratiladigan admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Yuz ma'lumotlari shifrlash kaliti (Fernet). Bo'sh bo'lsa data/.facekey yaratiladi.
# Generatsiya: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
FACE_ENC_KEY=

# Baza va vaqt
DB_PATH=./data/shams.db
APP_TZ=Asia/Tashkent
SESSION_DAYS=14
